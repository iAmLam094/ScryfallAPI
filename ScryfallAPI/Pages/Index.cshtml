@page "{handler?}"
@using ScryfallAPI
@using ScryfallData.Model
@inject ScryfallAPI.Utilities.APIRetriever ApiRetriever;
@model ScryfallAPI.Pages.IndexModel
@{

	var dataRetrieved = await ApiRetriever.GetData();

	<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

		<!-- Bootstrap CSS -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
	</head>

	<body>

		<h1 class="title">Scryfall Cards:</h1>


		<table class="table table-striped table-hover">
			<thead class="thead-dark">
				<tr>
					<th><bold>Card Id</bold> </th>
					<th><bold>Released Date</bold>&nbsp;</th>
					<th><bold>Penny Rank</bold></th>
					<th><bold>Name</bold></th>
					<th><bold>Mark</bold></th>
				</tr>
			</thead>
			<tbody>
				@foreach(var cards in dataRetrieved.Data )
				{
					<tr>
						<td> @cards.Id </td>
				
						<td> @cards.ReleasedAt </td>
						<td> @cards.PennyRank</td>
				
						<td> @cards.Name</td>
				
						<td>

							<form asp-page-handler="Send" method="post">
								<input type="hidden" name="id" value="@cards.Id">
								<input type="hidden" name="releasedDate" value="@cards.ReleasedAt">
								<input type="hidden" name="pennyRank" value="@cards.PennyRank">
								<input type="hidden" name="name" value="@cards.Name">
								<button type="submit" class="btn btn-primary">Favorite</button>

							</form>

						</td>
					</tr>
				}
			</tbody>
		</table>
	</body>	

	</html>

<style>
.title{
	margin-top: 2%;
	display:flex;
	justify-content: center;
	align-items: center;
}

.table-striped
{
	margin-left: auto;
	margin-right: auto;
}

</style>

}